ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# Solange nicht "true": nur Impressum + Datenschutz sind öffentlich erreichbar,
# der Rest zeigt einen "bald verfügbar"-Platzhalter. Auf "true" setzen, sobald
# die Seite fertig für den Launch ist.
SITE_LIVE=false

# WhatsApp-Nummer für den "Per WhatsApp anfragen"-Button (internationales Format ohne +, z.B. 4915112345678).
# Leer lassen = Button wird ausgeblendet.
WHATSAPP_NUMBER=

# "production" setzen, sobald hinter HTTPS deployed wird - aktiviert das
# "secure"-Flag am Admin-Session-Cookie
NODE_ENV=development

# Ports der beiden getrennten Prozesse (öffentliche Seite / Mitarbeiterbereich)
PUBLIC_PORT=3000
ADMIN_PORT=3001
