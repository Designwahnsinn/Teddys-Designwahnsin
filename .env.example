ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-to-a-long-random-string

# WhatsApp-Nummer für den "Per WhatsApp anfragen"-Button (internationales Format ohne +, z.B. 4915112345678).
# Leer lassen = Button wird ausgeblendet.
WHATSAPP_NUMBER=

# "production" setzen, sobald hinter HTTPS deployed wird - aktiviert das
# "secure"-Flag am Admin-Session-Cookie
NODE_ENV=development

# Ports der beiden getrennten Prozesse (öffentliche Seite / Mitarbeiterbereich)
PUBLIC_PORT=3000
ADMIN_PORT=3001

# Google-Drive-Sync (optional): leer lassen = Sync deaktiviert.
# Key-Datei liegt als google-drive-key.json im Projektordner (siehe docker-compose.yml,
# .gitignore) - Pfad hier ist der Pfad INNERHALB des Containers, nicht ändern.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/app/google-drive-key.json
GOOGLE_DRIVE_FOLDER_ID=
