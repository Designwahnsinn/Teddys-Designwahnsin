# Kopieren nach scripts/backup.env und Werte anpassen.
# backup.env selbst ist gitignored - enthält NAS-Zugangsdaten, gehört nicht ins Repo.

# SSH-Zugangsdaten der Synology NAS für den Backup-Push
NAS_SSH_USER=AdminE
NAS_SSH_HOST=<NAS-Adresse oder DDNS-Hostname>
NAS_SSH_PORT=22
NAS_BACKUP_PATH=/volume1/backups/teddys-designwahnsinn

# Pfad zum privaten SSH-Schlüssel auf dem VPS (dedizierter Schlüssel für
# diesen Zweck, per ssh-keygen erzeugt; Public Key als authorized_keys
# des NAS_SSH_USER auf der NAS hinterlegen)
BACKUP_SSH_KEY=/root/.ssh/teddys_backup_ed25519

# Wie viele Tage Backups auf der NAS aufbewahrt werden, bevor sie automatisch gelöscht werden
BACKUP_RETENTION_DAYS=14
